# Cargo build products
target/

# MSVC build products for the C reference harnesses
*.obj
*.exe
*.dll
*.pdb
*.ilk
porttest/*.exe
porttest/*.obj
porttest/librebound.*

# Verification dumps and run logs. Every one of these is regenerated by the
# commands in rebound_rust.md section 19; none is an input to anything, and
# some are tens of megabytes (the libm differential harness alone samples
# 200,000 points per function).
porttest/libm_*.txt
porttest/state_*.txt
porttest/bs_pow_*.txt
porttest/matrix_*.txt
porttest/*.log
logs/libm_c.txt

# LaTeX intermediates. rebound_rust.tex and rebound_rust.pdf ARE tracked;
# these are just the by-products of running pdflatex.
*.aux
*.out
*.toc
pdflatex_pass*.log

# Notebook execution logs
notebooks/run_all.log
notebooks/regen.log

# Ad-hoc diagnostic scratch from the defect investigations (the Kepler
# solver hang and the variational move_to_com). The reproducible probes
# live in porttest/ and examples/; these were one-off console captures.
/*.log
/*.aux
/*.out
/*.toc
!logs/

# Pre-modification file backups (HARD RULE 0). Kept on disk as the
# immediate undo while working; not committed, because git history is
# the durable undo. Same convention as the sibling rustSolveIt repo.
backups/
porttest/*.exp
porttest/*.lib
